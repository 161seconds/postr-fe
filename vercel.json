{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://postr-be.onrender.com/api/:path*" },
    { "source": "/fonts/:path*", "destination": "/public/fonts/:path*" },
    { "source": "/images/:path*", "destination": "/public/images/:path*" },
    { "source": "/favicon.svg", "destination": "/public/favicon.svg" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
